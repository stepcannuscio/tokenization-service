{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ApiHealthCheck": {
    "Enabled": true,
    "HealthCheckTimeoutSeconds": 1
  },
  "Auth": {
    "Authority": "https://dev-auth.example.com/",
    "Audience": "tokenization-api"
  },
  "DevelopmentAuth": {
    "Enabled": true,
    "BearerToken": "local-dev-token",
    "UserId": "local-dev-user",
    "TenantId": "demo-tenant",
    "Scopes": ["tokens.read", "tokens.create", "tokens.delete", "tokens.detokenize"],
    "Roles": ["token-admin"]
  },
  "Cors": {
    "PolicyName": "StrictCors",
    "AllowedOrigins": ["https://localhost:3000"],
    "AllowedMethods": ["GET", "POST", "DELETE", "OPTIONS"],
    "AllowAnyHeader": true,
    "DisallowCredentials": true
  },
  "Cache": {
    "RedisConnectionString": "localhost:6379",
    "InstanceName": "TokenizationApi",
    "EnableHealthChecks": true,
    "HealthCheckTimeoutSeconds": 5
  },
  "Idempotency": {
    "TtlSeconds": 600
  },
  "Security": {
    "UseHttpsRedirection": true,
    "HttpsPort": 7182,
    "HstsMaxAgeDays": 180,
    "JwtClockSkewMinutes": 2
  },
  "Swagger": {
    "Enabled": true
  },
  "RequestSize": {
    "MaxRequestBodySize": 32768,
    "MultipartBodyLengthLimit": 32768,
    "MaxFormValueLength": 4096,
    "MaxFormKeyLength": 1024,
    "ValueLengthLimit": 1024,
    "MaxFormFieldCount": 10
  },
  "KeyStorage": {
    "KeyProvider": "InMemory",
    "VaultUrl": "https://your-vault.vault.azure.net/",
    "KekKeyName": "kek-main",
    "BlindIndexKeyName": "blind-index-main",
    "UseInMemoryKeys": true,
    "EnableHealthChecks": true,
    "HealthCheckTimeoutSeconds": 10
  },
  "Database": {
    "ConnectionString": "Server=localhost,14333;Database=TokenizationService;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True",
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 30,
    "BaseDelaySeconds": 2,
    "CommandTimeoutSeconds": 30,
    "ConnectionTimeoutSeconds": 15,
    "MaxPoolSize": 100,
    "MinPoolSize": 5,
    "ConnectionLifetimeSeconds": 300,
    "EnableHealthChecks": true,
    "HealthCheckTimeoutSeconds": 5,
    "EnablePerformanceLogging": true,
    "SlowQueryThresholdMs": 1000
  }
}
